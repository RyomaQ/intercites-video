# Supabase Postgres (Settings > Database > Connection string, mode "Transaction" pooler recommandé pour Vercel)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Connexion directe (non poolée), requise par Prisma Migrate
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase (Settings > API) — utilisé pour Supabase Auth (interface admin, Phase 4)
# La table Code/Order reste gérée via Prisma (DATABASE_URL ci-dessus).
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# SumUp API — achat numérique via l'API Checkout (Hosted Checkout), voir Phase 3 du CLAUDE.md
SUMUP_API_KEY=""
SUMUP_MERCHANT_CODE=""
# Prix du film numérique en euros (montant décimal, ex: "12" ou "12.50")
NEXT_PUBLIC_DIGITAL_PRICE_EUR="4"
# URL publique de cette appli, utilisée pour construire le return_url du checkout
# (ex: https://video.intercitesbmx.com, ou une URL ngrok/tunnel en local pour recevoir le callback)
SITE_URL="http://localhost:3000"

# Backblaze B2 (stockage vidéo)
B2_APPLICATION_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_BUCKET_ID=""
B2_FILE_NAME="intercites.mp4"
# Bande-annonce jouée en fond sur la page d'accueil (distincte du film ci-dessus)
B2_TRAILER_FILE_NAME="trailer-web.mp4"
# Version portrait (9:16) de la bande-annonce, servie sur mobile
B2_TRAILER_MOBILE_FILE_NAME="trailer-web-mobile.mp4"

# Email transactionnel (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Intercites <noreply@intercitesbmx.com>"

# Note : SUPABASE_PING_URL n'est PAS une variable d'app — c'est un secret
# GitHub Actions à ajouter dans les settings du repo (ex: https://video.intercitesbmx.com/api/ping),
# utilisé par .github/workflows/supabase-ping.yml.
